# SceneSteward backend environment — copy to backend/.env and fill in.
# NEVER commit backend/.env. Never put service-role keys in frontend code.

APP_ENV=development            # development | test | staging | production
APP_NAME=SceneSteward
API_VERSION=v1
LOG_LEVEL=INFO

# PostgreSQL (required). Use a dedicated role, not the superuser.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/scenesteward
# Test database (used by pytest; create a separate database)
DATABASE_URL_TEST=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/scenesteward_test

# --- Authentication ---
# AUTH_PROVIDER: "dev" (local HS256 tokens, NOT for production) or "supabase".
AUTH_PROVIDER=dev
# Required when AUTH_PROVIDER=dev (openssl rand -hex 32)
AUTH_DEV_SECRET=
AUTH_ISSUER=scenesteward-dev
AUTH_AUDIENCE=scenesteward-api

# Required when AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_JWKS_URL=                 # e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Storage ---
# local = filesystem under STORAGE_LOCAL_PATH with HMAC-signed URLs (dev/demo)
# supabase = Supabase Storage private bucket (requires SUPABASE_* above)
STORAGE_PROVIDER=local
STORAGE_BUCKET=scenesteward-private
STORAGE_LOCAL_PATH=backend/var/storage
SIGNED_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400      # 25 MiB

# --- Encryption at rest for participant contact data (Fernet, 32 url-safe base64 bytes) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- AI agents ---
# offline = deterministic rule-based analysis (no external calls, default)
# anthropic = Claude API; requires ANTHROPIC_API_KEY
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1

# --- Switch (Agent Switch — agent protocol: SSE down, HTTP up, Bearer auth) ---
# test    = in-memory adapter for dev/tests (no network)
# http    = real adapter against SWITCH_BASE_URL (requires SWITCH_API_KEY + SWITCH_AGENT_ID)
SWITCH_ADAPTER=test
SWITCH_BASE_URL=               # e.g. http://127.0.0.1:8000 (switch-core)
SWITCH_API_KEY=                # agent API key (returned once at registration)
SWITCH_AGENT_ID=               # e.g. agent:<uuid>
SWITCH_REGISTRATION_TOKEN=     # registration/bootstrap token; used ONLY to register the agent
SWITCH_WEBHOOK_SECRET=         # unused today (Switch has no inbound webhooks for external services)

FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576      # 1 MiB JSON body cap; uploads use signed URLs
