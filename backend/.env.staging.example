# SceneSteward Staging Environment Configuration Template
# COPY TO: backend/.env.staging (NEVER COMMIT backend/.env.staging)
# This configuration isolates staging from development and production.

APP_ENV=staging
APP_NAME=SceneSteward-Staging
API_VERSION=v1
LOG_LEVEL=INFO

# --- Database Configuration (PostgreSQL 16) ---
POSTGRES_USER=scenesteward_staging
POSTGRES_PASSWORD=STAGING_OWNER_PASSWORD
POSTGRES_DB=scenesteward_staging
APP_USER=scenesteward_app
APP_PASSWORD=STAGING_APP_PASSWORD

# Runtime unprivileged user (NOBYPASSRLS)
DATABASE_URL=postgresql+psycopg://scenesteward_app:STAGING_APP_PASSWORD@127.0.0.1:5432/scenesteward_staging
# Schema owner used ONLY for running Alembic migrations (NEVER used by runtime web API)
MIGRATION_DATABASE_URL=postgresql+psycopg://scenesteward_staging:STAGING_OWNER_PASSWORD@127.0.0.1:5432/scenesteward_staging
# Identity trust boundary secret for HMAC-SHA256 authenticated RLS context
DATABASE_IDENTITY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# --- Authentication (Supabase Auth) ---
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SUPABASE_SERVICE_ROLE_KEY
AUTH_JWKS_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_STAGING_PROJECT_REF.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated

# --- Private Document Storage (Supabase Storage / S3) ---
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=scenesteward-staging-documents
SIGNED_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400

# --- Cryptographic Field-Level PII Encryption (Fernet 256-bit) ---
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=GENERATE_FERNET_KEY_HERE
APP_ENCRYPTION_CURRENT_KID=staging-primary-2026-v1
APP_ENCRYPTION_KEYS={"staging-primary-2026-v1": "GENERATE_FERNET_KEY_HERE"}

# --- Antivirus Scanning (ClamAV Daemon) ---
ANTIVIRUS_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
ANTIVIRUS_FAIL_CLOSED=true

# --- AI Agents (Anthropic Claude API) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api-YOUR_STAGING_API_KEY_HERE
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=45.0
AI_MAX_RETRIES=1

# --- Switch Collaboration Integration ---
SWITCH_ADAPTER=http
SWITCH_BASE_URL=https://staging.switch.your-domain.com
SWITCH_API_KEY=YOUR_SWITCH_AGENT_API_KEY
SWITCH_AGENT_ID=agent:YOUR_SWITCH_AGENT_UUID
SWITCH_WEBHOOK_SECRET=YOUR_SWITCH_WEBHOOK_HMAC_SECRET

# --- Observability & Security Limits ---
METRICS_ENABLED=true
FRONTEND_ORIGIN=https://staging.scenesteward.your-domain.com
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576

